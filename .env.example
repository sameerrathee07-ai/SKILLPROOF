# SkillProof Environment Variables
NODE_ENV=development
PORT=3000

# Database Connection (SQLite path, relative to prisma/schema.prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillproof?schema=public"

# Gate Calibration Thresholds
NEXT_PUBLIC_GATE_THRESHOLD=6.0
GATE_MIN_EFFORT_CHARS=200

# HMAC secret for the signed session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Put the real value in .env.local (gitignored), never here.
SESSION_SECRET=""

# NextAuth Configuration
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth Credentials (from Google Cloud Console)
# Put real values in .env.local (gitignored), never here.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
