# SkillProof Environment Variables
NODE_ENV=development
PORT=3000

# Database Connection (SQLite local path or PostgreSQL URL for production)
DATABASE_URL="file:./dev.db"

# Gate Calibration Thresholds
NEXT_PUBLIC_GATE_THRESHOLD=6.0
GATE_MIN_EFFORT_CHARS=200

# HMAC secret for the signed session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Put the real value in .env.local (gitignored), never here.
SESSION_SECRET="dev-secret-change-me"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="skillproof_secret_key_prod_dev_32_characters_min_length"

# Google OAuth Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
