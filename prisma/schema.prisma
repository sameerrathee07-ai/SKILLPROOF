generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  name             String?
  emailVerified    DateTime?
  image            String?
  role             String    @default("SOLVER") // SOLVER, POSTER, ADMIN
  tokens           Int       @default(50)
  credibilityScore Float     @default(1.0)
  createdAt        DateTime  @default(now())
  pitches          Pitch[]
  problemsPosted   Problem[] @relation("PostedProblems")
  accounts         Account[]
  sessions         Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  type      String    // COACHING_CENTER, TUITION_ACADEMY, COLLEGE_DEPT
  createdAt DateTime  @default(now())
  problems  Problem[]
}

model Problem {
  id               String       @id @default(cuid())
  organizationId   String
  postedById       String?
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  postedBy         User?        @relation("PostedProblems", fields: [postedById], references: [id], onDelete: SetNull)
  title            String
  description      String
  frictionCategory String       // SCHEDULING, STUDENT_RETENTION, ADMIN_WORKFLOW
  status           String       @default("OPEN") // OPEN, CLOSED
  createdAt        DateTime     @default(now())
  pitches          Pitch[]
}

model Pitch {
  id             String   @id @default(cuid())
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  solverId       String
  solver         User     @relation(fields: [solverId], references: [id], onDelete: Cascade)
  stepData       String   // JSON string storing the 5 steps
  score          Float
  passed         Boolean
  knockedOut     Boolean
  scoreBreakdown String   // JSON string storing dimensional breakdown and actionable feedback
  revisionCount  Int      @default(0)
  createdAt      DateTime @default(now())
}